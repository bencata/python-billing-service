# pyenv
#   For a library or package, you might want to ignore these files since the code is
#   intended to run in multiple environments; otherwise, check them in:
# .python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, in case of collaboration, if lock is not desired, it can be added to here.
#Pipfile.lock

# poetry
#   Similar to Pipfile.lock, poetry.lock is generally tracked in version control.
#Poetry.lock

# pdm
#   Similar to Poetry and Pipenv, pdm.lock is generally tracked in version control
#pdm.lock
#   pdm build stage
.pdm-build/

